# Provide the cereal::cereal target for LibRPA (and the LibRI/LibComm headers).
# Order: explicit CEREAL_INCLUDE_DIR, then the pinned archive in
# TAESC_THIRDPARTY_ARCHIVE_DIR (downloaded when TAESC_THIRDPARTY_DOWNLOAD=ON).
# The pin matches src/LibRPA/thirdparty/manifest.cmake, so the same archive file
# serves scripts/prepare_thirdparty.sh for offline builds.
set(_cereal_commit d81e2f7df7b334fee057e53017388d02e555a836)
set(_cereal_archive cereal-d81e2f7.tar.gz)
set(_cereal_url "https://github.com/USCiLab/cereal/archive/${_cereal_commit}.tar.gz")
set(_cereal_sha256 0f2d26b5c6c2f0188f3e065625dff31c5ca034ba6e9e5e6b1034803660c0aa04)

set(CEREAL_INCLUDE_DIR "${CEREAL_INCLUDE_DIR}" CACHE PATH "Explicit cereal include directory")
set(_cereal_dir "${CEREAL_INCLUDE_DIR}")
if("${_cereal_dir}" STREQUAL "" AND NOT "$ENV{CEREAL_INCLUDE_DIR}" STREQUAL "")
  set(_cereal_dir "$ENV{CEREAL_INCLUDE_DIR}")
  if(NOT IS_ABSOLUTE "${_cereal_dir}")
    message(FATAL_ERROR "cereal: CEREAL_INCLUDE_DIR='${_cereal_dir}' from the environment is relative. Supply an absolute path.")
  endif()
  # Keep the selection across automatic reconfiguration, as LibRPA does.
  set(CEREAL_INCLUDE_DIR "${_cereal_dir}" CACHE PATH "Explicit cereal include directory" FORCE)
  message(STATUS "cereal: using and caching CEREAL_INCLUDE_DIR from environment: ${_cereal_dir}")
endif()

if(TARGET cereal::cereal)
  # Supplied by a parent project: use it as is.
  set(_cereal_include "")
  set(_cereal_status target)
elseif(NOT "${_cereal_dir}" STREQUAL "")
  if(NOT EXISTS "${_cereal_dir}/cereal/cereal.hpp")
    message(FATAL_ERROR "cereal: invalid CEREAL_INCLUDE_DIR=${_cereal_dir}; missing cereal/cereal.hpp. No download fallback is allowed for an explicit path.")
  endif()
  set(_cereal_include "${_cereal_dir}")
  set(_cereal_status path)
else()
  set(_cereal_file "${TAESC_THIRDPARTY_ARCHIVE_DIR}/${_cereal_archive}")
  set(_cereal_status archive)
  if(NOT EXISTS "${_cereal_file}")
    if(NOT TAESC_THIRDPARTY_DOWNLOAD)
      message(FATAL_ERROR "cereal: ${_cereal_file} not found and TAESC_THIRDPARTY_DOWNLOAD=OFF. Run scripts/prepare_thirdparty.sh on a connected machine and copy thirdparty/archives/ here.")
    endif()
    file(MAKE_DIRECTORY "${TAESC_THIRDPARTY_ARCHIVE_DIR}")
    file(DOWNLOAD "${_cereal_url}" "${_cereal_file}.part" STATUS _st TLS_VERIFY ON INACTIVITY_TIMEOUT 60)
    list(GET _st 0 _code)
    if(NOT _code EQUAL 0)
      file(REMOVE "${_cereal_file}.part")
      message(FATAL_ERROR "cereal: download of ${_cereal_url} failed: ${_st}")
    endif()
    file(RENAME "${_cereal_file}.part" "${_cereal_file}")
    set(_cereal_status downloaded)
  endif()
  file(SHA256 "${_cereal_file}" _actual)
  if(NOT _actual STREQUAL _cereal_sha256)
    file(REMOVE "${_cereal_file}")
    message(FATAL_ERROR "cereal: SHA-256 mismatch for ${_cereal_archive} (got ${_actual}); the file was removed.")
  endif()
  set(_cereal_root "${CMAKE_BINARY_DIR}/_deps/cereal")
  set(_cereal_include "${_cereal_root}/cereal-${_cereal_commit}/include")
  if(NOT EXISTS "${_cereal_include}/cereal/cereal.hpp")
    file(REMOVE_RECURSE "${_cereal_root}")
    file(ARCHIVE_EXTRACT INPUT "${_cereal_file}" DESTINATION "${_cereal_root}")
  endif()
  if(NOT EXISTS "${_cereal_include}/cereal/cereal.hpp")
    message(FATAL_ERROR "cereal: ${_cereal_include}/cereal/cereal.hpp missing after extraction.")
  endif()
endif()

if(NOT _cereal_status STREQUAL "target")
  taesc_header_target(cereal::cereal "${_cereal_include}")
endif()
message(STATUS "cereal: ${_cereal_status}, includes=${_cereal_include}")
